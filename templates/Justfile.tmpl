set dotenv-load

lang := env_var_or_default("LANG", "java")
build_tool := env_var_or_default("BUILD_TOOL", "maven")
module := env_var_or_default("MODULE", ".")
profile := env_var_or_default("PROFILE", "dev")
skip_tests := env_var_or_default("SKIP_TESTS", "false")
app_justfile := env_var_or_default("APP_JUSTFILE", "helpers/just/app.just")

# Mostrar tareas disponibles
@default:
    just --list

# Cargar tareas operativas de aplicación desde helpers/just/app.just
# Si no existe, se imprime guía sin fallar el flujo base.
@ops:
    if [ -f "{{app_justfile}}" ]; then \
        just --justfile "{{app_justfile}}" --list; \
    else \
        echo "No existe {{app_justfile}}"; \
        echo "Agrega helpers/just/app.just para tareas como create-user/login/db-create"; \
    fi

# Ejemplo operativo: crear usuario
@create-user username email:
    if [ -f "{{app_justfile}}" ]; then \
        just --justfile "{{app_justfile}}" create-user "{{username}}" "{{email}}"; \
    else \
        echo "No existe {{app_justfile}}"; \
        exit 1; \
    fi

# Ejemplo operativo: login
@login username password:
    if [ -f "{{app_justfile}}" ]; then \
        just --justfile "{{app_justfile}}" login "{{username}}" "{{password}}"; \
    else \
        echo "No existe {{app_justfile}}"; \
        exit 1; \
    fi

# Construir el proyecto
@build:
    echo "Building project (lang={{lang}}, tool={{build_tool}}, module={{module}}, profile={{profile}})..."
    LANG={{lang}} BUILD_TOOL={{build_tool}} MODULE={{module}} PROFILE={{profile}} SKIP_TESTS={{skip_tests}} make build

# Ejecutar tests
@test:
    echo "Running tests (lang={{lang}}, tool={{build_tool}}, module={{module}}, profile={{profile}})..."
    LANG={{lang}} BUILD_TOOL={{build_tool}} MODULE={{module}} PROFILE={{profile}} make test

# Limpiar artefactos
@clean:
    echo "Cleaning build artifacts..."
    rm -rf build/
    rm -rf dist/
    rm -rf site/

# Generar documentación
@docs:
    echo "Building documentation..."
    mkdocs build

# Servir documentación localmente
@serve:
    echo "Serving documentation on http://localhost:8000"
    mkdocs serve

# Validar estilo de código
@lint:
    LANG={{lang}} BUILD_TOOL={{build_tool}} MODULE={{module}} make lint

# Formatear código
@format:
    LANG={{lang}} BUILD_TOOL={{build_tool}} MODULE={{module}} make format

# Detectar runtime de contenedor
@runtime:
    make runtime

# Construir imagen de CI
@image:
    LANG={{lang}} BUILD_TOOL={{build_tool}} MODULE={{module}} PROFILE={{profile}} SKIP_TESTS={{skip_tests}} make image

# Ejecutar CI local en contenedor
@ci:
    LANG={{lang}} BUILD_TOOL={{build_tool}} MODULE={{module}} PROFILE={{profile}} SKIP_TESTS={{skip_tests}} make ci

# Asegurar artefactos antes de operativas que lo requieran
@ensure-artifact:
    LANG={{lang}} BUILD_TOOL={{build_tool}} MODULE={{module}} PROFILE={{profile}} SKIP_TESTS={{skip_tests}} make ci

# Ejecutar todas las validaciones
@validate: lint test

# Preparar para release
@prepare-release version:
    git tag -a v{{ version }} -m "Release v{{ version }}"
    git push origin v{{ version }}
