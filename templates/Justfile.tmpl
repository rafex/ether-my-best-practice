set dotenv-load

lang := env_var_or_default("LANG", "java")
build_tool := env_var_or_default("BUILD_TOOL", "maven")
module := env_var_or_default("MODULE", ".")
profile := env_var_or_default("PROFILE", "dev")
skip_tests := env_var_or_default("SKIP_TESTS", "false")

# Mostrar tareas disponibles
@default:
    just --list

# Construir el proyecto
@build:
    echo "Building project (lang={{lang}}, tool={{build_tool}}, module={{module}}, profile={{profile}})..."
    LANG={{lang}} BUILD_TOOL={{build_tool}} MODULE={{module}} PROFILE={{profile}} SKIP_TESTS={{skip_tests}} make build

# Ejecutar tests
@test:
    echo "Running tests (lang={{lang}}, tool={{build_tool}}, module={{module}}, profile={{profile}})..."
    LANG={{lang}} BUILD_TOOL={{build_tool}} MODULE={{module}} PROFILE={{profile}} make test

# Limpiar artefactos
@clean:
    echo "Cleaning build artifacts..."
    rm -rf build/
    rm -rf dist/
    rm -rf site/

# Generar documentación
@docs:
    echo "Building documentation..."
    mkdocs build

# Servir documentación localmente
@serve:
    echo "Serving documentation on http://localhost:8000"
    mkdocs serve

# Validar estilo de código
@lint:
    LANG={{lang}} BUILD_TOOL={{build_tool}} MODULE={{module}} make lint

# Formatear código
@format:
    LANG={{lang}} BUILD_TOOL={{build_tool}} MODULE={{module}} make format

# Ejecutar todas las validaciones
@validate: lint test

# Preparar para release
@prepare-release version:
    git tag -a v{{ version }} -m "Release v{{ version }}"
    git push origin v{{ version }}
