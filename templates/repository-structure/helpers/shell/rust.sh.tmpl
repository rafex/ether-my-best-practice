#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/logs.sh"
source "$SCRIPT_DIR/lib/messages.sh"
init_log "rust"


# ------------------------------------------------------------------
# Helper de Rust — build, test, serve.
# Reutilizable por Makefile (vía helpers/mk/rust.mk) y Justfile.
#
# Contrato de flags (regla 01):
#   --tool cargo                       Herramienta de construcción
#   --goal build|test|serve|run        Operación
#   --port 8080                        Puerto (serve, opcional)
#   --host 0.0.0.0                     Host (opcional)
#   --release                          (flag) Build en modo release
#   --command  (opcional)              Comando directo (sobreescribe goal)
#   --log-file /ruta/al/log            Obligatorio
#   --log-level info                   (opcional)
#
# Para agentes de IA: este script atiende las operativas de Rust.
# serve/run -> cargo run
# build     -> cargo build
# test      -> cargo test
#
# Auditoría: /var/log/<proyecto>/log-rust-<ts>.log
#             Fallback → /tmp/<proyecto>/log-rust-<ts>.log
# ------------------------------------------------------------------

tool="cargo"
goal=""
release="false"
port="8080"
host="0.0.0.0"
command_line=""
log_file=""
log_level="info"
workspace="$(pwd)"

while [[ $# -gt 0 ]]; do
	case "$1" in
		--tool)      tool="${2:-}"; shift 2 ;;
		--goal)      goal="${2:-}"; shift 2 ;;
		--port)      port="${2:-}"; shift 2 ;;
		--host)      host="${2:-}"; shift 2 ;;
		--release)   release="true"; shift ;;
		--command)   command_line="${2:-}"; shift 2 ;;
		--log-file)  log_file="${2:-}"; shift 2 ;;
		--log-level) log_level="${2:-}"; shift 2 ;;
		*)
			echo "Unknown flag: $1" >&2
			exit 1 ;;
	esac
done

if [[ -n "$command_line" ]]; then
	goal=""
fi
if [[ -z "$goal" && -z "$command_line" ]]; then
	echo "Missing required flag --goal or --command" >&2
	exit 1
fi

project_name="$(basename "$workspace")"
script_name="rust"
ts="$(date -u +%Y%m%dT%H%M%SZ)"

if [[ -z "$log_file" ]]; then
	if mkdir -p "/var/log/$project_name" 2>/dev/null && [[ -w "/var/log/$project_name" ]]; then
		log_file="/var/log/$project_name/log-$script_name-$ts.log"
	else
		mkdir -p "/tmp/$project_name"
		log_file="/tmp/$project_name/log-$script_name-$ts.log"
	fi
fi

mkdir -p "$(dirname "$log_file")"
exec > >(tee -a "$log_file") 2>&1

echo "Audit log: $log_file"
echo "Tool: $tool"
echo "Goal: $goal"
echo "Workspace: $workspace"

cd "$workspace"

resolve_cmd() {
	local rflag=""
	if [[ "$release" == "true" ]]; then
		rflag="--release"
	fi

	case "$goal" in
		build)  echo "cargo build $rflag" ;;
		test)   echo "cargo test" ;;
		serve|run)
			echo "cargo run $rflag"
			;;
		*)      echo "" ;;
	esac
}

if [[ -n "$command_line" ]]; then
	cmd="$command_line"
else
	cmd="$(resolve_cmd)"
	if [[ -z "$cmd" ]]; then
		echo "Unknown goal: $goal" >&2
		exit 1
	fi
fi

echo "Executing: $cmd"
bash -lc "$cmd"
