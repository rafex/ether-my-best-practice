#!/usr/bin/env bash
set -euo pipefail

# ------------------------------------------------------------------
# Helper de Python — build, test, serve.
# Reutilizable por Makefile (vía helpers/mk/python.mk) y Justfile.
#
# Contrato de flags (regla 01):
#   --tool uv|poetry|pip               Gestor de dependencias/entorno
#   --goal build|test|serve|dev        Operación
#   --module .                         Subdirectorio (opcional)
#   --port 8000                        Puerto (serve/dev)
#   --host 0.0.0.0                     Host (opcional)
#   --command  (opcional)              Comando directo (sobreescribe goal)
#   --log-file /ruta/al/log            Obligatorio
#   --log-level info                   (opcional)
#
# Para agentes de IA: este script atiende las operativas de Python.
# serve/dev -> uv run uvicorn, flask run, fastapi dev
# build     -> uv build, poetry build
# test      -> uv run pytest, poetry run pytest
#
# Auditoría: /var/log/<proyecto>/log-python-<ts>.log
#             Fallback → /tmp/<proyecto>/log-python-<ts>.log
# ------------------------------------------------------------------

tool="uv"
goal=""
module="."
port="8000"
host="0.0.0.0"
command_line=""
log_file=""
log_level="info"
workspace="$(pwd)"

while [[ $# -gt 0 ]]; do
	case "$1" in
		--tool)      tool="${2:-}"; shift 2 ;;
		--goal)      goal="${2:-}"; shift 2 ;;
		--module)    module="${2:-}"; shift 2 ;;
		--port)      port="${2:-}"; shift 2 ;;
		--host)      host="${2:-}"; shift 2 ;;
		--command)   command_line="${2:-}"; shift 2 ;;
		--log-file)  log_file="${2:-}"; shift 2 ;;
		--log-level) log_level="${2:-}"; shift 2 ;;
		*)
			echo "Unknown flag: $1" >&2
			exit 1 ;;
	esac
done

if [[ -n "$command_line" ]]; then
	goal=""
fi
if [[ -z "$goal" && -z "$command_line" ]]; then
	echo "Missing required flag --goal or --command" >&2
	exit 1
fi

project_name="$(basename "$workspace")"
script_name="python"
ts="$(date -u +%Y%m%dT%H%M%SZ)"

if [[ -z "$log_file" ]]; then
	if mkdir -p "/var/log/$project_name" 2>/dev/null && [[ -w "/var/log/$project_name" ]]; then
		log_file="/var/log/$project_name/log-$script_name-$ts.log"
	else
		mkdir -p "/tmp/$project_name"
		log_file="/tmp/$project_name/log-$script_name-$ts.log"
	fi
fi

mkdir -p "$(dirname "$log_file")"
exec > >(tee -a "$log_file") 2>&1

echo "Audit log: $log_file"
echo "Tool: $tool"
echo "Goal: $goal"
echo "Module: $module"
echo "Workspace: $workspace"

cd "$workspace"
if [[ -n "$module" && "$module" != "." ]]; then
	cd "$module"
fi

resolve_cmd() {
	case "$tool" in
		uv)
			case "$goal" in
				build)  echo "uv build" ;;
				test)   echo "uv run pytest" ;;
				serve|dev)
					if uv run uvicorn --version >/dev/null 2>&1; then
						echo "uv run uvicorn main:app --host $host --port $port --reload"
					elif uv run flask --version >/dev/null 2>&1; then
						echo "uv run flask run --host $host --port $port --reload"
					else
						echo "uv run fastapi dev main:app --host $host --port $port"
					fi
					;;
				*)      echo "" ;;
			esac
			;;
		poetry)
			case "$goal" in
				build)  echo "poetry build" ;;
				test)   echo "poetry run pytest" ;;
				serve|dev)
					echo "poetry run uvicorn main:app --host $host --port $port --reload"
					;;
				*)      echo "" ;;
			esac
			;;
		pip)
			case "$goal" in
				build)  echo "python -m build" ;;
				test)   echo "pytest" ;;
				serve|dev)
					echo "python -m uvicorn main:app --host $host --port $port --reload"
					;;
				*)      echo "" ;;
			esac
			;;
		*)
			echo "Unknown tool: $tool. Expected uv|poetry|pip" >&2
			exit 1
			;;
	esac
}

if [[ -n "$command_line" ]]; then
	cmd="$command_line"
else
	cmd="$(resolve_cmd)"
	if [[ -z "$cmd" ]]; then
		echo "Unknown goal: $goal for tool $tool" >&2
		exit 1
	fi
fi

echo "Executing: $cmd"
bash -lc "$cmd"
