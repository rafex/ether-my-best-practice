#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/logs.sh"
source "$SCRIPT_DIR/lib/messages.sh"
init_log "docs"


# ------------------------------------------------------------------
# Helper de Docs — build, serve.
# Reutilizable por Makefile (vía helpers/mk/docs.mk) y Justfile.
#
# Contrato de flags (regla 01):
#   --goal build|serve                 Operación
#   --site-dir site                    Directorio de salida del sitio
#   --command  (opcional)              Comando directo (sobreescribe goal)
#   --log-file /ruta/al/log            Obligatorio
#   --log-level info                   (opcional)
#
# Para agentes de IA: este script atiende operativas de documentación.
# serve -> mkdocs serve
# build -> mkdocs build
#
# Auditoría: /var/log/<proyecto>/log-docs-<ts>.log
#             Fallback → /tmp/<proyecto>/log-docs-<ts>.log
# ------------------------------------------------------------------

goal=""
site_dir="site"
command_line=""
log_file=""
log_level="info"
workspace="$(pwd)"

while [[ $# -gt 0 ]]; do
	case "$1" in
		--goal)      goal="${2:-}"; shift 2 ;;
		--site-dir)  site_dir="${2:-}"; shift 2 ;;
		--command)   command_line="${2:-}"; shift 2 ;;
		--log-file)  log_file="${2:-}"; shift 2 ;;
		--log-level) log_level="${2:-}"; shift 2 ;;
		*)
			echo "Unknown flag: $1" >&2
			exit 1 ;;
	esac
done

if [[ -n "$command_line" ]]; then
	goal=""
fi
if [[ -z "$goal" && -z "$command_line" ]]; then
	echo "Missing required flag --goal or --command" >&2
	exit 1
fi

project_name="$(basename "$workspace")"
script_name="docs"
ts="$(date -u +%Y%m%dT%H%M%SZ)"

if [[ -z "$log_file" ]]; then
	if mkdir -p "/var/log/$project_name" 2>/dev/null && [[ -w "/var/log/$project_name" ]]; then
		log_file="/var/log/$project_name/log-$script_name-$ts.log"
	else
		mkdir -p "/tmp/$project_name"
		log_file="/tmp/$project_name/log-$script_name-$ts.log"
	fi
fi

mkdir -p "$(dirname "$log_file")"
exec > >(tee -a "$log_file") 2>&1

echo "Audit log: $log_file"
echo "Goal: $goal"
echo "Workspace: $workspace"

cd "$workspace"

resolve_cmd() {
	case "$goal" in
		build)  echo "mkdocs build --site-dir \"$site_dir\"" ;;
		serve)  echo "mkdocs serve" ;;
		*)      echo "" ;;
	esac
}

if [[ -n "$command_line" ]]; then
	cmd="$command_line"
else
	cmd="$(resolve_cmd)"
	if [[ -z "$cmd" ]]; then
		echo "Unknown goal: $goal" >&2
		exit 1
	fi
fi

echo "Executing: $cmd"
bash -lc "$cmd"
