#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/logs.sh"
source "$SCRIPT_DIR/lib/messages.sh"
init_log "format"


# ------------------------------------------------------------------
# Helper de format genérico multi-lenguaje.
# Reutilizable por Makefile (vía helpers/mk/format.mk) y Justfile.
#
# Contrato de flags (regla 01):
#   --tool npm|pnpm|yarn|maven|gradle|uv|poetry|cargo
#   --module .                       Subdirectorio (opcional)
#   --command  (opcional)            Comando directo (sobreescribe tool)
#   --log-file /ruta/al/log          Obligatorio
#   --log-level info                 (opcional)
#
# Para agentes de IA: este script atiende formateo por herramienta.
#   npm    → npm run format
#   pnpm   → pnpm format
#   maven  → mvn spotless:apply
#   gradle → gradle spotlessApply
#   uv     → uv run ruff format .
#   poetry → poetry run ruff format .
#   cargo  → cargo fmt
#
# Auditoría: /var/log/<proyecto>/log-format-<ts>.log
#             Fallback → /tmp/<proyecto>/log-format-<ts>.log
# ------------------------------------------------------------------

tool=""
module="."
command_line=""
log_file=""
log_level="info"
workspace="$(pwd)"

while [[ $# -gt 0 ]]; do
	case "$1" in
		--tool)      tool="${2:-}"; shift 2 ;;
		--module)    module="${2:-}"; shift 2 ;;
		--command)   command_line="${2:-}"; shift 2 ;;
		--log-file)  log_file="${2:-}"; shift 2 ;;
		--log-level) log_level="${2:-}"; shift 2 ;;
		*)
			echo "Unknown flag: $1" >&2
			exit 1 ;;
	esac
done

if [[ -n "$command_line" ]]; then
	tool=""
fi
if [[ -z "$tool" && -z "$command_line" ]]; then
	echo "Missing required flag --tool or --command" >&2
	exit 1
fi

project_name="$(basename "$workspace")"
script_name="format"
ts="$(date -u +%Y%m%dT%H%M%SZ)"

if [[ -z "$log_file" ]]; then
	if mkdir -p "/var/log/$project_name" 2>/dev/null && [[ -w "/var/log/$project_name" ]]; then
		log_file="/var/log/$project_name/log-$script_name-$ts.log"
	else
		mkdir -p "/tmp/$project_name"
		log_file="/tmp/$project_name/log-$script_name-$ts.log"
	fi
fi

mkdir -p "$(dirname "$log_file")"
exec > >(tee -a "$log_file") 2>&1

echo "Audit log: $log_file"
echo "Tool: $tool"
echo "Module: $module"
echo "Workspace: $workspace"

if [[ -n "$module" && "$module" != "." ]]; then
	cd "$workspace/$module"
else
	cd "$workspace"
fi

resolve_cmd() {
	case "$tool" in
		npm)    echo "npm run format" ;;
		pnpm)   echo "pnpm format" ;;
		yarn)   echo "yarn format" ;;
		maven|mvn) echo "mvn spotless:apply" ;;
		gradle) echo "gradle spotlessApply" ;;
		uv)     echo "uv run ruff format ." ;;
		poetry) echo "poetry run ruff format ." ;;
		cargo)  echo "cargo fmt" ;;
		*)
			echo "Unknown tool: $tool. Expected npm|pnpm|yarn|maven|gradle|uv|poetry|cargo" >&2
			exit 1
			;;
	esac
}

if [[ -n "$command_line" ]]; then
	cmd="$command_line"
else
	cmd="$(resolve_cmd)"
	if [[ -z "$cmd" ]]; then
		echo "Unknown tool: $tool" >&2
		exit 1
	fi
fi

echo "Executing: $cmd"
bash -lc "$cmd"
