#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/logs.sh"
source "$SCRIPT_DIR/lib/messages.sh"
init_log "env"

# ------------------------------------------------------------------
# env.sh — Gestión de variables de entorno (regla 13).
# Reutilizable por Makefile y Justfile.
#
# Estrategia: carpeta .enviroments/ con .env.<entorno> SIN secretos,
# un symlink .env → .enviroments/.env.<entorno> para el entorno activo,
# y merge de secretos desencriptados + variables del proceso en runtime.
#
# Contrato (regla 01):
#   --action link|merge|verify       Operación
#   --env dev|test|prod              Entorno
#   --log-file /ruta/al/log          Obligatorio
#   --log-level info                 (opcional)
#
# Precedencia en merge: el SECRETO (de .secrets/) gana sobre la variable
# pública. El helper imprime un warning con el valor de la variable pública
# perdida; el secreto NUNCA se imprime.
#
# Auditoría: helpers/shell/lib/logs.sh (regla 15)
# ------------------------------------------------------------------

action=""
env_name=""
workspace="$(pwd)"
ENV_DIR=".enviroments"

while [[ $# -gt 0 ]]; do
	case "$1" in
		--action)   action="${2:-}"; shift 2 ;;
		--env)      env_name="${2:-}"; shift 2 ;;
		--log-file) log_file="${2:-}"; shift 2 ;;
		--log-level)log_level="${2:-}"; shift 2 ;;
		*)
			die "Unknown flag: $1"
			;;
	esac
done

[[ -z "$action" ]] && die "Missing required flag --action"

# ─── link: crear/actualizar symlink .env ─────────────────────────────
do_link() {
	[[ -z "$env_name" ]] && die "Missing --env para link"
	local target="$ENV_DIR/.env.${env_name}"
	if [[ ! -f "$target" ]]; then
		die "No existe $target. Ejecuta 'just env $env_name' primero."
	fi
	if [[ -e ".env" && ! -L ".env" ]]; then
		die ".env existe y no es un symlink. Revisa antes de sobreescribir."
	fi
	ln -sfn "$target" .env
	success ".env → $target"
}

# ─── merge: combinar secretos desencriptados + variables públicas ────
do_merge() {
	[[ -z "$env_name" ]] && die "Missing --env para merge"
	local enc_file=".secrets/secrets.${env_name}.enc.yaml"
	local env_file="$ENV_DIR/.env.${env_name}"

	if [[ ! -f "$enc_file" ]]; then
		die "No existe $enc_file. Créalo con 'just edit-secrets $env_name'."
	fi

	# Secretos desencriptados → mapa (nunca se imprimen)
	if ! command -v sops >/dev/null 2>&1; then
		die "sops no instalado (necesario para merge)."
	fi

	local key_path="${HOME}/.age/$(basename "$workspace")-key.txt"
	[[ -f "$key_path" ]] || die "No se encontró clave age en $key_path"

	declare -A secrets
	while IFS='=' read -r k v; do
		[[ -z "$k" ]] && continue
		secrets["$k"]="$v"
	done < <(SOPS_AGE_KEY_FILE="$key_path" sops --config .config/sops/.sops.yaml decrypt --output-type yaml "$enc_file" 2>/dev/null | python3 -c "
import sys, yaml
data = yaml.safe_load(sys.stdin) or {}
for k, v in data.items():
    print(f'{k}={v}')
")

	# Variables públicas de .enviroments/.env.<env>
	if [[ -f "$env_file" ]]; then
		while IFS='=' read -r k v; do
			[[ -z "$k" || "$k" == \#* ]] && continue
			if [[ -n "${secrets[$k]+x}" ]]; then
				warning "Colisión: '$k' pública ($v) será reemplazada por el secreto. Valor público perdido."
			fi
		done < "$env_file"
	fi

	success "Merge completado: $((${#secrets[@]})) secreto(s) + variables públicas."
}

# ─── verify: comprobar symlink y ausencia de secretos en .env-* ──────
do_verify() {
	if [[ -L ".env" ]]; then
		success ".env → $(readlink .env)"
	else
		warning ".env no es un symlink (o no existe). Usa 'just env-link <env>'."
	fi
	if command -v gitleaks >/dev/null 2>&1; then
		gitleaks git --staged 2>/dev/null && success "gitleaks: sin secretos staged."
	else
		warning "gitleaks no instalado."
	fi
}

case "$action" in
	link)   do_link ;;
	merge)  do_merge ;;
	verify) do_verify ;;
	*)      die "Unknown action: $action. Expected link|merge|verify." ;;
esac
