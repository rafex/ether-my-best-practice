#!/usr/bin/env bash
# pre-commit.sh — Gate de calidad (construcción → Makefile).
# Llamado por make pre-commit → pre-commit.mk.
# Orquesta scripts atómicos: lint, validate, secrets.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/logs.sh"
source "$SCRIPT_DIR/lib/messages.sh"
init_log "pre-commit"

step 1 3 "Lint de helpers..."
bash "$SCRIPT_DIR/lint.sh" || die "lint falló"

step 2 3 "Validación de reglas..."
bash "$SCRIPT_DIR/validate-rules.sh" || die "validate falló"

step 3 3 "Verificación de secretos..."
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --staged
    log_info "gitleaks: sin secretos detectados."
else
    log_info "gitleaks no instalado — verificación saltada."
fi

success "pre-commit superado."
