#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/logs.sh"
source "$SCRIPT_DIR/lib/messages.sh"
init_log "javascript"


# ------------------------------------------------------------------
# Helper de JavaScript — build, test, serve.
# Reutilizable por Makefile (vía helpers/mk/javascript.mk) y Justfile.
#
# Contrato de flags (regla 01):
#   --tool npm|pnpm|yarn              Gestor de paquetes
#   --goal build|test|serve|dev       Operación
#   --module web                      Subdirectorio (opcional)
#   --port 3000                       Puerto (serve/dev)
#   --host 0.0.0.0                    Host (opcional)
#   --command  (opcional)             Comando directo (sobreescribe goal)
#   --log-file /ruta/al/log           Obligatorio
#   --log-level info                  (opcional)
#
# Para agentes de IA: este script atiende las operativas de JavaScript.
# serve/dev -> npm start, npm run dev, pnpm dev
# build     -> npm run build, pnpm build
# test      -> npm test, pnpm test
#
# Auditoría: /var/log/<proyecto>/log-javascript-<ts>.log
#             Fallback → /tmp/<proyecto>/log-javascript-<ts>.log
# ------------------------------------------------------------------

tool="npm"
goal=""
module="."
port="3000"
host="0.0.0.0"
command_line=""
log_file=""
log_level="info"
workspace="$(pwd)"

while [[ $# -gt 0 ]]; do
	case "$1" in
		--tool)      tool="${2:-}"; shift 2 ;;
		--goal)      goal="${2:-}"; shift 2 ;;
		--module)    module="${2:-}"; shift 2 ;;
		--port)      port="${2:-}"; shift 2 ;;
		--host)      host="${2:-}"; shift 2 ;;
		--command)   command_line="${2:-}"; shift 2 ;;
		--log-file)  log_file="${2:-}"; shift 2 ;;
		--log-level) log_level="${2:-}"; shift 2 ;;
		*)
			echo "Unknown flag: $1" >&2
			exit 1 ;;
	esac
done

if [[ -n "$command_line" ]]; then
	goal=""
fi
if [[ -z "$goal" && -z "$command_line" ]]; then
	echo "Missing required flag --goal or --command" >&2
	exit 1
fi

project_name="$(basename "$workspace")"
script_name="javascript"
ts="$(date -u +%Y%m%dT%H%M%SZ)"

if [[ -z "$log_file" ]]; then
	if mkdir -p "/var/log/$project_name" 2>/dev/null && [[ -w "/var/log/$project_name" ]]; then
		log_file="/var/log/$project_name/log-$script_name-$ts.log"
	else
		mkdir -p "/tmp/$project_name"
		log_file="/tmp/$project_name/log-$script_name-$ts.log"
	fi
fi

mkdir -p "$(dirname "$log_file")"
exec > >(tee -a "$log_file") 2>&1

echo "Audit log: $log_file"
echo "Tool: $tool"
echo "Goal: $goal"
echo "Module: $module"
echo "Workspace: $workspace"

if [[ -n "$module" && "$module" != "." ]]; then
	cd "$workspace/$module"
else
	cd "$workspace"
fi

resolve_cmd() {
	case "$tool" in
		npm)
			case "$goal" in
				build)  echo "npm run build" ;;
				test)   echo "npm test" ;;
				serve|dev)
					if npm run dev --if-present >/dev/null 2>&1; then
						echo "npm run dev"
					else
						echo "npm start"
					fi
					;;
				*)      echo "" ;;
			esac
			;;
		pnpm)
			case "$goal" in
				build)  echo "pnpm build" ;;
				test)   echo "pnpm test" ;;
				serve|dev) echo "pnpm dev" ;;
				*)      echo "" ;;
			esac
			;;
		yarn)
			case "$goal" in
				build)  echo "yarn build" ;;
				test)   echo "yarn test" ;;
				serve|dev) echo "yarn dev" ;;
				*)      echo "" ;;
			esac
			;;
		*)
			echo "Unknown tool: $tool. Expected npm|pnpm|yarn" >&2
			exit 1
			;;
	esac
}

if [[ -n "$command_line" ]]; then
	cmd="$command_line"
else
	cmd="$(resolve_cmd)"
	if [[ -z "$cmd" ]]; then
		echo "Unknown goal: $goal for tool $tool" >&2
		exit 1
	fi
fi

echo "Executing: $cmd"
bash -lc "$cmd"
