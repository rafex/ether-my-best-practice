PAGES_WORKFLOW ?= static.yml
PAGES_REF ?= main
GITHUB_HELPER ?= helpers/shell/github.sh

.PHONY: pages

pages:
	@if [ -f "$(GITHUB_HELPER)" ]; then \
		bash "$(GITHUB_HELPER)" --action workflow-run --workflow "$(PAGES_WORKFLOW)" --ref "$(PAGES_REF)"; \
	else \
		echo "No github helper found. Expected helpers/shell/github.sh"; \
		exit 1; \
	fi
