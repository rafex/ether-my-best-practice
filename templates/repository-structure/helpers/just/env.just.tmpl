# helpers/just/env.just — Operativas de variables de entorno (regla 13).
# Reutiliza helpers/shell/env.sh (script atómico, regla 15).
# Gestión de symlink .env y merge de secretos + variables.

# Activar entorno (actualiza symlink .env)
@env-link env:
    bash helpers/shell/env.sh --action link --env {{env}}

# Merge de secretos desencriptados + variables públicas
@env-merge env:
    bash helpers/shell/env.sh --action merge --env {{env}}

# Verificar symlink y ausencia de secretos en plano
@env-verify:
    bash helpers/shell/env.sh --action verify
