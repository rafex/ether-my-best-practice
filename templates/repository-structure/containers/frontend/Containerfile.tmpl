# Containerfile — Imagen de frontend (Node.js).
#
# Propósito: Build estático y serve del frontend (SPA, SSR).
# Usa Node.js LTS para construir assets y servir con nginx o node.
#
# Construir con: podman build -f containers/frontend/Containerfile -t proyecto-frontend:local .

# ------------------------------------------------------------------
# Opción 1: Alpine con Node.js LTS
# ------------------------------------------------------------------
FROM alpine:3.21@sha256:a8560b36e8b821935b80f241b3d2bbad9fd9d5e6e9e9b9e9b9e9b9e9b9e9b9e9

RUN apk add --no-cache nodejs npm bash

COPY . /app/
WORKDIR /app

RUN npm install && npm run build

EXPOSE 3000

# Serve estático con un servidor ligero o node
# ENTRYPOINT ["npx", "serve", "dist", "-l", "3000"]
ENTRYPOINT ["/bin/bash", "-lc", "npm start"]
