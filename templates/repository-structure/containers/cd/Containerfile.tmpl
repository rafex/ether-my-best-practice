# Containerfile — Imagen de CD (deploy).
#
# Propósito: Desplegar artefactos a staging/producción.
# Runtime ligero con herramientas de deploy (gh, git, curl).
#
# Stack recomendado (regla 08):
#   - Base: Alpine.
#   - Runtime: Podman primero.
#
# Construir con: podman build -f containers/cd/Containerfile -t proyecto-cd:local .

FROM alpine:3.21@sha256:a8560b36e8b821935b80f241b3d2bbad9fd9d5e6e9e9b9e9b9e9b9e9b9e9b9e9

RUN apk add --no-cache bash curl git ca-certificates tzdata openssh

# GitHub CLI para despliegues y releases
# RUN apk add --no-cache github-cli

# Kubectl (si despliegas en Kubernetes)
# RUN curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" \
#     && install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl

COPY . /workspace/
WORKDIR /workspace

ENTRYPOINT ["/bin/bash", "-lc"]
