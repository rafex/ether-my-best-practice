# Containerfile — Imagen runtime de backend (Java / Python / Rust).
#
# Propósito: Ejecución de APIs y servicios backend en producción.
# No incluye toolchain de build — solo el runtime necesario para ejecutar.
#
# Construir con: podman build -f containers/backend/Containerfile -t proyecto-backend:local .
#
# Los agentes de IA deben descomentar el toolchain según el lenguaje del backend.

# ------------------------------------------------------------------
# Opción 1: Alpine (recomendado)
# ------------------------------------------------------------------
FROM alpine:3.21@sha256:a8560b36e8b821935b80f241b3d2bbad9fd9d5e6e9e9b9e9b9e9b9e9b9e9b9e9

RUN apk add --no-cache bash ca-certificates curl tzdata

# --- Java (Temurin 25 LTS) ---
# RUN apk add --no-cache openjdk25-jre
# ENV JAVA_HOME=/usr/lib/jvm/java-25-openjdk

# --- Python 3.12+ ---
# RUN apk add --no-cache python3

# --- Rust (binary std) ---
# COPY target/release/mi-app /app/

COPY . /app/
WORKDIR /app

EXPOSE 8080
ENTRYPOINT ["/bin/bash", "-lc", "java -jar app.jar"]
