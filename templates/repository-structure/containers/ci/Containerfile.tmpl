# Containerfile.ci — Imagen de CI con toolchain completo multi-lenguaje.
#
# Propósito: Ejecutar la cadena completa de build + test + lint en contenedor.
# Incluye todas las herramientas de construcción para todos los lenguajes.
#
# Stack recomendado (regla 08):
#   - Base: Alpine (preferido). Debian-slim como fallback.
#   - Runtime: Podman primero, Docker con warning.
#   - Nombre de archivo: Containerfile.ci, nunca Dockerfile.
#
# Construir con: podman build -f containers/ci/Containerfile -t proyecto-ci:local .
#
# Los agentes de IA deben descomentar el toolchain del lenguaje que corresponda
# al proyecto consumidor. No incluir todo el toolchain si no se necesita.

# ------------------------------------------------------------------
# Opción 1: Alpine (recomendado por defecto)
# ------------------------------------------------------------------
FROM alpine:3.21@sha256:a8560b36e8b821935b80f241b3d2bbad9fd9d5e6e9e9b9e9b9e9b9e9b9e9b9e9

RUN apk add --no-cache bash curl git ca-certificates tzdata

