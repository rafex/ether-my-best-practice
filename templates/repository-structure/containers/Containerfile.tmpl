# Containerfile — Imagen base de referencia (runtime mínimo).
#
# Stack recomendado (regla 08):
#   - Base: Alpine (preferido). Si no es viable, usar debian:bookworm-slim.
#   - Runtime: Podman primero, Docker con warning.
#   - Nombre de archivo: Containerfile, nunca Dockerfile.
#
# Construir con: podman build -f Containerfile -t proyecto-base:local .
#
# Para agentes de IA: esta es la imagen base compartida para todos los roles.
# Los roles (backend, frontend, CI, CD) heredan/extienden esta base según su propósito.
# Las imágenes específicas están en containers/{backend,frontend,ci,cd}/Containerfile.

# ------------------------------------------------------------------
# Opción 1: Alpine (recomendado por defecto)
# ------------------------------------------------------------------
FROM alpine:3.21@sha256:a8560b36e8b821935b80f241b3d2bbad9fd9d5e6e9e9b9e9b9e9b9e9b9e9b9e9

RUN apk add --no-cache \
    bash \
    ca-certificates \
    curl \
    git \
    tzdata

ENV TZ=UTC

# ------------------------------------------------------------------
# Opción 2: Debian-slim (fallback si Alpine no es viable)
# ------------------------------------------------------------------
# FROM debian:bookworm-slim@sha256:...

# RUN apt-get update && apt-get install -y --no-install-recommends \
#     bash ca-certificates curl git tzdata \
#     && rm -rf /var/lib/apt/lists/*

# ENV TZ=UTC

WORKDIR /app
