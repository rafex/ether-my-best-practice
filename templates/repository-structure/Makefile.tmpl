.PHONY: help build test clean runtime image ci

# Punto de entrada universal — Solo construcción/artefactos.
# La lógica específica por lenguaje se delega a helpers.
# Justfile es el task manager; aquí solo build, test, clean, ci.

LANG ?= java
BUILD_TOOL ?= maven
MODULE ?= .
PROFILE ?= dev
SKIP_TESTS ?= false
MK_FILES ?= $(wildcard helpers/mk/*.mk)
SITE_DIR ?= site
PAGES_WORKFLOW ?= static.yml
PAGES_REF ?= main

# Carga modular: permite N archivos .mk por lenguaje, dominio o capability.
-include $(MK_FILES)

.DEFAULT_GOAL := help

help:
	@echo "Makefile — Construcción (build/artefactos)"
	@echo "  make build    - Ejecutar build del proyecto"
	@echo "  make test     - Ejecutar tests del proyecto"
	@echo "  make clean    - Limpiar artefactos del proyecto"
	@echo "  make docs     - Generar documentación"
	@echo "  make pages    - Publicar sitio en GitHub Pages"
	@echo "  make image    - Construir imagen de CI"
	@echo "  make ci       - Ejecutar build+test en contenedor"
	@echo "  make lint     - Validar sintaxis de código"
	@echo "  make format   - Formatear código"
	@echo ""
	@echo "  make pre-commit   - Gate de calidad (lint + validate + secrets)"
	@echo "  make pre-push     - Gate de test (test + secrets)"
	@echo ""
	@echo "Modular: los targets viven en helpers/mk/*.mk."
	@echo "Operativas → just <receta> (task manager)."

# Regla de máxima reutilización: el Makefile nunca ejecuta comandos directos.
# Todo target se define en helpers/mk/*.mk y delega en helpers/shell/*.sh.
# Justfile orquesta tareas operativas (composición de varios pasos, captura de parámetros).
