# Justfile — Task manager de operativas (no proxy pass de make).
# Las tareas de construcción/artefactos están en el Makefile.
# Justfile orquesta acciones compuestas, captura parámetros y organiza por dominio.
# Justfile → Makefile está permitido cuando se necesiten artefactos.

set dotenv-load

lang := env_var_or_default("LANG", "java")
build_tool := env_var_or_default("BUILD_TOOL", "maven")
module := env_var_or_default("MODULE", ".")

# Default: listar tareas disponibles
@default:
    just --list

# Importar dominios operativos (pueden agregarse más)
import 'helpers/just/app.just'
import 'helpers/just/users.just'
import 'helpers/just/auth.just'
import 'helpers/just/hooks.just'
import 'helpers/just/worktree.just'
import 'helpers/just/env.just'

# --- Tareas que orquestan (composición de pasos, NO proxy pass) ---

# Preview del sitio: compilar + levantar servidor local
@preview-site:
    make docs
    bash helpers/shell/serve.sh --action serve

# Crear usuario (ejemplo de dominio — la lógica real en users.sh)
@new-user username email:
    make serve
    bash helpers/shell/users.sh --new {{username}} {{email}}

# Login de usuario (ejemplo de dominio)
@login username password:
    bash helpers/shell/auth.sh --login {{username}} {{password}}

# Desplegar: build + test + release
@deploy:
    make ci
    make release

# Preparar release: bump + changelog + tag + push
@prepare-release version:
    git tag -a v{{ version }} -m "Release v{{ version }}"
    git push origin v{{ version }}
