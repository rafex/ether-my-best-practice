# .gitignore — secretos / credenciales
# Template de referencia: templates/gitignore/.gitignore.secretos.tmpl
# Para el agente de IA: combinar con el .gitignore de cada ubicación (raíz, backend, etc.)
# según dónde se generen credenciales.

# Variables de entorno con secretos (generados por just env <entorno>)
.env
.env.*
!.env.example
!.env.tmpl

# Carpeta de variables de entorno (regla 13) — solo .env.example se versiona
.enviroments/.env.*
!.enviroments/.env.example

# Claves privadas age (NUNCA versionar, viven en ~/.age/<proyecto>-key.txt)
~/.age/

# Secretos en plano (solo los *.enc.yaml se versionan)
.secrets/*.yaml
.secrets/*.yml
.secrets/*.json
# Permitir solo los cifrados con sops
!.secrets/*.enc.yaml

# Claves privadas y certificados
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.cer
*.crt

# Nubes (descomentar según proveedor)
# .aws/
# .gcloud/
# .azure/

# SSH
# .ssh/

# Tokens y credenciales locales
# credentials/
# secrets/
# *.token
