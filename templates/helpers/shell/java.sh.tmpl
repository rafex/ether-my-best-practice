#!/usr/bin/env bash
set -euo pipefail

# ------------------------------------------------------------------
# Helper de Java — build, test, serve.
# Reutilizable por Makefile (vía helpers/mk/java.mk) y Justfile.
#
# Contrato de flags (regla 01):
#   --tool maven|gradle               Herramienta de construcción
#   --goal build|test|serve|run       Operación
#   --module .                        Módulo Maven/Gradle (opcional)
#   --profile dev                     Perfil (opcional)
#   --skip-tests                      (flag) Saltar tests si aplica
#   --port 8080                       Puerto (serve)
#   --host 0.0.0.0                    Host (serve, opcional)
#   --command  (opcional)             Comando directo (sobreescribe goal)
#   --log-file /ruta/al/log           Obligatorio
#   --log-level info                  (opcional)
#
# Para agentes de IA: este script atiende las operativas de Java.
# serve -> mvn exec:java o gradle bootRun.
# build -> mvn package o gradle build.
# test  -> mvn test o gradle test.
#
# Auditoría: /var/log/<proyecto>/log-java-<ts>.log
#             Fallback → /tmp/<proyecto>/log-java-<ts>.log
# ------------------------------------------------------------------

tool="maven"
goal=""
module="."
profile=""
skip_tests="false"
port="8080"
host="0.0.0.0"
command_line=""
log_file=""
log_level="info"
workspace="$(pwd)"

while [[ $# -gt 0 ]]; do
	case "$1" in
		--tool)          tool="${2:-}"; shift 2 ;;
		--goal)          goal="${2:-}"; shift 2 ;;
		--module)        module="${2:-}"; shift 2 ;;
		--profile)       profile="${2:-}"; shift 2 ;;
		--skip-tests)    skip_tests="true"; shift ;;
		--port)          port="${2:-}"; shift 2 ;;
		--host)          host="${2:-}"; shift 2 ;;
		--command)       command_line="${2:-}"; shift 2 ;;
		--log-file)      log_file="${2:-}"; shift 2 ;;
		--log-level)     log_level="${2:-}"; shift 2 ;;
		*)
			echo "Unknown flag: $1" >&2
			exit 1 ;;
	esac
done

if [[ -n "$command_line" ]]; then
	goal=""
fi
if [[ -z "$goal" && -z "$command_line" ]]; then
	echo "Missing required flag --goal or --command" >&2
	exit 1
fi

project_name="$(basename "$workspace")"
script_name="java"
ts="$(date -u +%Y%m%dT%H%M%SZ)"

if [[ -z "$log_file" ]]; then
	if mkdir -p "/var/log/$project_name" 2>/dev/null && [[ -w "/var/log/$project_name" ]]; then
		log_file="/var/log/$project_name/log-$script_name-$ts.log"
	else
		mkdir -p "/tmp/$project_name"
		log_file="/tmp/$project_name/log-$script_name-$ts.log"
	fi
fi

mkdir -p "$(dirname "$log_file")"
exec > >(tee -a "$log_file") 2>&1

echo "Audit log: $log_file"
echo "Tool: $tool"
echo "Goal: $goal"
echo "Module: $module"
echo "Workspace: $workspace"

cd "$workspace"

resolve_cmd() {
	local skip=""
	if [[ "$skip_tests" == "true" ]]; then
		skip="-DskipTests"
	fi
	local extra=""
	if [[ -n "$profile" ]]; then
		extra="-P$profile"
	fi

	case "$tool" in
		maven|mvn)
			case "$goal" in
				build)  echo "mvn package $skip $extra -pl \"$module\"" ;;
				test)   echo "mvn test $extra -pl \"$module\"" ;;
				serve|run)
					echo "mvn exec:java $extra -pl \"$module\" -Dexec.mainClass=com.example.Application" ;;
				*)      echo "" ;;
			esac
			;;
		gradle)
			case "$goal" in
				build)  echo "gradle build $([[ "$skip_tests" == "true" ]] && echo '-x test')" ;;
				test)   echo "gradle test" ;;
				serve|run)
					echo "gradle bootRun --args='--server.port=$port'" ;;
				*)      echo "" ;;
			esac
			;;
		*)
			echo "Unknown tool: $tool. Expected maven|gradle" >&2
			exit 1
			;;
	esac
}

if [[ -n "$command_line" ]]; then
	cmd="$command_line"
else
	cmd="$(resolve_cmd)"
	if [[ -z "$cmd" ]]; then
		echo "Unknown goal: $goal for tool $tool" >&2
		exit 1
	fi
fi

echo "Executing: $cmd"
bash -lc "$cmd"
