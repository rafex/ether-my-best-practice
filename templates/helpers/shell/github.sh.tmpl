#!/usr/bin/env bash
set -euo pipefail

# ------------------------------------------------------------------
# Helper compartido de GitHub — reutilizable por Makefile y Justfile.
# Atiende operaciones contra la API/GitHub CLI: disparar workflows.
#
# Contrato de flags (regla 01):
#   --action workflow-run              Operación a ejecutar
#   --workflow static.yml              Workflow a disparar
#   --ref main                         Rama o ref sobre la que se dispara
#   --repo  (opcional)                 Repositorio owner/repo (auto-detecta)
#   --log-file /ruta/al/log            Obligatorio — ruta del log de auditoría
#   --log-level info                   (opcional) Nivel de log
#
# Política de auditoría:
#   1. /var/log/<proyecto>/log-github-<ts>.log
#   2. Fallback: /tmp/<proyecto>/log-github-<ts>.log
#
# Uso desde Makefile:
#   bash helpers/shell/github.sh --action workflow-run \
#       --workflow static.yml --ref main --log-file /var/log/proyecto/log-github-20260807T120000Z.log
#
# Uso desde Justfile:
#   bash helpers/shell/github.sh --action workflow-run \
#       --workflow static.yml --ref main --log-file /tmp/proyecto/log-github-20260807T120000Z.log
# ------------------------------------------------------------------

action=""
workflow=""
ref="main"
repo=""
log_file=""
log_level="info"
workspace="$(pwd)"

while [[ $# -gt 0 ]]; do
	case "$1" in
		--action)
			action="${2:-}"; shift 2 ;;
		--workflow)
			workflow="${2:-}"; shift 2 ;;
		--ref)
			ref="${2:-}"; shift 2 ;;
		--repo)
			repo="${2:-}"; shift 2 ;;
		--log-file)
			log_file="${2:-}"; shift 2 ;;
		--log-level)
			log_level="${2:-}"; shift 2 ;;
		*)
			echo "Unknown flag: $1" >&2
			exit 1 ;;
	esac
done

if [[ -z "$action" ]]; then
	echo "Missing required flag --action" >&2
	exit 1
fi
if [[ -z "$workflow" ]]; then
	echo "Missing required flag --workflow" >&2
	exit 1
fi

project_name="$(basename "$workspace")"
script_name="github"
ts="$(date -u +%Y%m%dT%H%M%SZ)"

if [[ -z "$log_file" ]]; then
	if mkdir -p "/var/log/$project_name" 2>/dev/null && [[ -w "/var/log/$project_name" ]]; then
		log_file="/var/log/$project_name/log-$script_name-$ts.log"
	else
		mkdir -p "/tmp/$project_name"
		log_file="/tmp/$project_name/log-$script_name-$ts.log"
	fi
fi

mkdir -p "$(dirname "$log_file")"
exec > >(tee -a "$log_file") 2>&1

echo "Audit log: $log_file"
echo "Action: $action"
echo "Workflow: $workflow"
echo "Ref: $ref"
echo "Level: $log_level"

case "$action" in
	workflow-run)
		if ! command -v gh >/dev/null 2>&1; then
			echo "GitHub CLI (gh) no está disponible. Instala gh para disparar workflows." >&2
			exit 1
		fi
		gh_args=()
		if [[ -n "$repo" ]]; then
			gh_args+=(--repo "$repo")
		fi
		echo "Disparando workflow $workflow en ref=$ref..."
		gh workflow run "$workflow" --ref "$ref" "${gh_args[@]}"
		echo "Workflow $workflow disparado correctamente en $ref"
		;;
	*)
		echo "Unknown action: $action" >&2
		exit 1 ;;
esac
