LANG ?= java
BUILD_TOOL ?= maven
MODULE ?= .
FORMAT_HELPER ?= helpers/shell/format.sh
FORMAT_HELPER_PY ?= helpers/python/format.py

.PHONY: format

format:
	@if [ -f "$(FORMAT_HELPER)" ]; then \
		bash "$(FORMAT_HELPER)" --tool "$(BUILD_TOOL)" --module "$(MODULE)"; \
	elif [ -f "$(FORMAT_HELPER_PY)" ]; then \
		uv run python "$(FORMAT_HELPER_PY)" --lang "$(LANG)" --module "$(MODULE)"; \
	else \
		echo "No format helper found. Expected helpers/shell/format.sh or helpers/python/format.py"; \
		exit 1; \
	fi
